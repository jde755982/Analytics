# ============================================================
#  StarPal Analytics (SaaS) — environment
#  Single shared .env at the project root. Only VITE_* vars reach the browser.
# ============================================================

# ---- Database (Postgres) ----
# On Railway, add a Postgres plugin and reference its variable.
DATABASE_URL=postgresql://user:password@localhost:5432/starpal

# ---- Auth ----
# Long random string — signs session JWTs. Generate: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
# Initial StarPal staff (admin) account, created by `npm run seed`.
STAFF_EMAIL=admin@starpal.ai
STAFF_PASSWORD=change-me-now

# ---- Upstream StarPal API (read-only; no auth, CORS open) ----
STARPAL_API_BASE=https://pal-maker-api-dot-symbolic-fire-99808.appspot.com

# ---- Anthropic (server only, NEVER exposed to the browser) ----
ANTHROPIC_API_KEY=sk-ant-...
# Confirm exact current model IDs against Anthropic docs before relying on these.
ANTHROPIC_MODEL=claude-haiku-4-5
ANTHROPIC_JUDGE_MODEL=claude-sonnet-4-6

# ---- Server ----
PORT=8787
# Base path the app is served under (e.g. starpal.ai/analytics). Keep server
# BASE_PATH and web VITE_BASE_PATH in sync.
BASE_PATH=/analytics
NODE_ENV=development

# ---- Web (build-time) ----
# Base path for the built assets — must match BASE_PATH (with trailing slash).
VITE_BASE_PATH=/analytics/
# Leave empty for same-origin (recommended). Set only for split front/back hosts.
# VITE_API_BASE=
